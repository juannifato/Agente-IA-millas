<Window x:Class="VentanaToken"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Token de Aerolíneas" Height="420" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13" Background="#F5F3FF"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Token de Aerolíneas" FontSize="18" FontWeight="SemiBold"
                   Foreground="#2E1065"/>

        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="White"
                BorderBrush="#E4DDF5" BorderThickness="1">
            <TextBlock x:Name="txtEstado" Text="Consultando estado…" Foreground="#6B5B95"
                       TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,14,0,4" TextWrapping="Wrap" Foreground="#6B5B95"
                   Text="El token dura 24 h. Cuando vence, copiá uno nuevo del navegador (F12 → Network → la llamada 'offers' → Headers → Authorization, todo lo que va después de 'Bearer ') y pegalo acá abajo:"/>

        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E4DDF5"
                BorderThickness="1" Padding="4" Margin="0,4,0,0">
            <TextBox x:Name="txtToken" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0"
                     Background="Transparent" FontFamily="Consolas" FontSize="12"/>
        </Border>

        <TextBlock Grid.Row="4" x:Name="txtMensaje" Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnCerrar" Content="Cerrar" Padding="14,7" Margin="0,0,8,0"
                    Cursor="Hand" Click="btnCerrar_Click"/>
            <Button x:Name="btnGuardar" Content="Guardar token" Padding="16,7" Cursor="Hand"
                    Background="#7C3AED" Foreground="White" BorderThickness="0"
                    Click="btnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
