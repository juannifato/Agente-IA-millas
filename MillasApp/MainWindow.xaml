<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MillasApp"
        Title="Agente Millas IA" Height="660" Width="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="#F4F5F7"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titulo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Agente Millas IA" FontSize="24" FontWeight="SemiBold" Foreground="#1A2233"/>
            <TextBlock Text="Buscá el pasaje en millas más conveniente" Foreground="#66707D"/>
        </StackPanel>

        <!-- Formulario -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16"
                BorderBrush="#E1E4E8" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Origen" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtOrigen" Width="90" Padding="6,4"
                                 CharacterCasing="Upper" MaxLength="3"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Destino" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtDestino" Width="90" Padding="6,4"
                                 CharacterCasing="Upper" MaxLength="3"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Fecha ida" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtFecha" Width="120" Padding="6,4"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Fecha vuelta (opcional)" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtVuelta" Width="130" Padding="6,4"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Adultos" Margin="0,0,0,3"/>
                        <ComboBox x:Name="cboAdultos" Width="55" Padding="6,4"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Aerolínea" Margin="0,0,0,3"/>
                        <ComboBox x:Name="cboAerolinea" Width="300" Padding="6,4"
                                  DisplayMemberPath="nombre"/>
                    </StackPanel>
                    <Button x:Name="btnBuscar" Content="Buscar mejor vuelo" Padding="18,8"
                            VerticalAlignment="Bottom" Background="#2D6CDF" Foreground="White"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                            Click="btnBuscar_Click"/>
                </StackPanel>

                <TextBlock Text="Formato de fecha: DD/MM/AAAA (ej. 15/09/2026)"
                           Foreground="#98A0AB" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Estado / error -->
        <TextBlock x:Name="txtEstado" Grid.Row="2" Margin="2,12,0,4"
                   TextWrapping="Wrap" Foreground="#C0392B"/>

        <!-- Resultado -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16"
                BorderBrush="#E1E4E8" BorderThickness="1" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" x:Name="panelResumen" Visibility="Collapsed">
                    <TextBlock x:Name="txtResumen" FontSize="18" FontWeight="SemiBold" Foreground="#1A2233"/>
                    <TextBlock x:Name="txtAnalisis" TextWrapping="Wrap" FontStyle="Italic"
                               Foreground="#4A5261" Margin="0,4,0,0"/>
                    <TextBlock x:Name="txtNota" Foreground="#C0392B" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <DataGrid x:Name="grdTramos" Grid.Row="1" Margin="0,12,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          Background="White" RowBackground="White" AlternatingRowBackground="#F7F9FC"
                          CanUserAddRows="False" CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tramo" Binding="{Binding tramo}" Width="70"/>
                        <DataGridTextColumn Header="Vuelo" Binding="{Binding VuelosTexto}" Width="120"/>
                        <DataGridTextColumn Header="Ruta" Binding="{Binding RutaTexto}" Width="110"/>
                        <DataGridTextColumn Header="Sale" Binding="{Binding SaleTexto}" Width="90"/>
                        <DataGridTextColumn Header="Llega" Binding="{Binding LlegaTexto}" Width="90"/>
                        <DataGridTextColumn Header="Escalas" Binding="{Binding EscalasTexto}" Width="80"/>
                        <DataGridTextColumn Header="Duración" Binding="{Binding DuracionTexto}" Width="80"/>
                        <DataGridTextColumn Header="Tarifa" Binding="{Binding tarifa}" Width="140"/>
                        <DataGridTextColumn Header="Millas" Binding="{Binding MillasTexto}" Width="70"/>
                        <DataGridTextColumn Header="Impuestos" Binding="{Binding ImpuestosTexto}" Width="90"/>
                        <DataGridTextColumn Header="Asientos" Binding="{Binding asientos}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
