# Copiá este archivo como ".env" y completá los valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# API key de Groq -> https://console.groq.com/keys
GROQ_API_KEY=gsk_pegar_aca_tu_clave

# Modelo de Groq a usar. Los Llama pasaron a ser tier Enterprise,
# gpt-oss-120b es el gratuito recomendado (ver https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b

# Puerto del backend local (Flask)
PORT=3000

# Token Bearer de la API de Aerolineas Argentinas.
# Se saca del DevTools del navegador (F12 > Network > la llamada "offers" >
# Headers > Authorization), pegando lo que va DESPUES de la palabra "Bearer".
# Dura 24 h EXACTAS: cuando venza, el backend devuelve motivo "token_vencido".
AEROLINEAS_TOKEN=

# Secreto para renovar el token solo (evita pegarlo a mano cada 24 h).
# El token sale de POST https://api.aerolineas.com.ar/v1/auth/token, que pide
# este client_secret. Se saca del DevTools (F12 > Network > la llamada
# "auth/token" > pestana Payload). Es una credencial de la web: tratala con el
# mismo cuidado que la de Groq. Con esto cargado, correr:
#     .\.venv\Scripts\python.exe renovar_token.py
AEROLINEAS_CLIENT_SECRET=

# (opcional) client_id, por si el publico embebido en el JWT dejara de servir.
# AEROLINEAS_CLIENT_ID=
